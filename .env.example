# =============================================
# TELEGRAM SAAS BACKEND - Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# --- Server ---
PORT=3000

# --- Security ---
# A strong random secret for API authentication (e.g., use: openssl rand -hex 32)
API_SECRET_KEY=your_strong_random_secret_here

# --- Database ---
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI (OpenAI) ---
OPENAI_API_KEY=sk-your_openai_api_key_here
